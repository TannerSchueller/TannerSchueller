<link href="https://fonts.googleapis.com/css2?family=Anton&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0d0b09;--panel:#1a1612;--line:#3a2f24;--ink:#eadfcd;--muted:#a39784;--orange:#ff6a13;--rust:#7a230c;
--display:"Anton",Impact,"Arial Narrow",sans-serif;--body:"Courier Prime","Courier New",monospace;
--holes:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='26' height='14'><rect x='6' y='3' width='14' height='8' rx='2' fill='%230d0b09'/></svg>")}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:1.05rem/1.7 var(--body);min-height:100vh;display:flex;flex-direction:column}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:50;background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.7) 100%)}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:51;opacity:.08;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
a{color:var(--orange)}
a:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
h1,h2,h3{font-family:var(--display);font-weight:400;letter-spacing:.03em;line-height:1.05;margin:0}
.wrap{max-width:64rem;margin:0 auto;padding:0 1.5rem}
main{flex:1}
.strip::before,.strip::after{content:"";display:block;height:14px;background:var(--holes) repeat-x}
header.site{background:var(--panel);border-bottom:1px solid var(--line)}
.bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;padding:.6rem 1.5rem;max-width:64rem;margin:0 auto}
.logo{font:1.5rem var(--display);letter-spacing:.06em;text-decoration:none;color:var(--ink)}
nav{display:flex;flex-wrap:wrap;gap:.5rem}
nav a{font:1rem var(--display);letter-spacing:.08em;text-decoration:none;color:var(--ink);border:1px solid var(--line);padding:.35rem .9rem}
nav a:hover{color:var(--orange);border-color:var(--orange)}
nav a[aria-current=page]{background:var(--orange);border-color:var(--orange);color:var(--bg)}
.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:center;padding:clamp(2.5rem,8vw,5rem) 0}
h1.title{font-size:clamp(3.5rem,12vw,8rem);line-height:.95;text-transform:uppercase;text-shadow:0 0 30px rgba(255,106,19,.4);animation:flicker 2s linear 1}
.hero p{font-size:1.2rem;color:var(--muted);max-width:30rem;margin:1.25rem 0 1.75rem}
.reel{width:min(100%,24rem);justify-self:center;color:var(--orange);animation:spin 60s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes flicker{0%,18%,22%,60%,64%,100%{opacity:1}20%,62%{opacity:.2}21%{opacity:.8}}
.btn{display:inline-block;border:2px solid var(--orange);color:var(--orange);padding:.5rem 1.25rem;font:1.1rem var(--display);letter-spacing:.08em;text-decoration:none;margin:0 .75rem .75rem 0}
.btn:hover,.btn.solid{background:var(--orange);color:var(--bg)}
.btn.solid:hover{background:transparent;color:var(--orange)}
h1.page-title{font-size:clamp(2.75rem,9vw,5.5rem);text-transform:uppercase;padding-top:clamp(2rem,6vw,4rem);text-shadow:0 0 24px rgba(255,106,19,.3)}
.lede{color:var(--muted);max-width:36rem;margin:1rem 0 2.5rem}
section{padding:2.5rem 0}
h2{font-size:2rem;margin-bottom:1.5rem;color:var(--orange)}
.frames{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.5rem}
.frame{display:block;background:var(--panel);border:1px solid var(--line);color:var(--ink);text-decoration:none}
a.frame:hover{border-color:var(--orange)}
a.frame:hover h3{color:var(--orange)}
.frame .cap{padding:.9rem 1rem 1rem}
.frame h3{font-size:1.4rem;margin-bottom:.25rem}
.frame p{margin:0;color:var(--muted);font-size:.95rem;line-height:1.5}
.shot{position:relative;aspect-ratio:16/9;display:grid;place-items:center;background:linear-gradient(135deg,var(--rust),var(--bg));color:var(--muted);font-size:.9rem}
.shot.tall{aspect-ratio:4/5}
.shot.video::after{content:"";border-left:28px solid var(--orange);border-top:18px solid transparent;border-bottom:18px solid transparent}
.frame iframe{display:block;width:100%;aspect-ratio:16/9;border:0}
.frame img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
.split{display:grid;grid-template-columns:18rem 1fr;gap:2.5rem;align-items:start}
.split p{margin:0 0 1rem;max-width:38rem}
.films{list-style:none;margin:0;padding:0}
.films li{border-top:1px solid var(--line);padding:.5rem 0}
.credit{display:grid;grid-template-columns:11rem 1fr;gap:1rem;border-top:1px solid var(--line);padding:1.25rem 0}
.credit .when{color:var(--orange)}
.credit h3{font-size:1.5rem}
.credit p{margin:.25rem 0 0;color:var(--muted)}
.skills{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;margin:0;padding:0}
.skills li{border:1px solid var(--line);padding:.15rem .8rem;font-size:.95rem}
.email{font:clamp(1.6rem,6vw,3rem)/1.2 var(--display);letter-spacing:.03em;word-break:break-word}
.links{display:flex;gap:1.5rem;flex-wrap:wrap;margin:1.5rem 0 0;padding:0;list-style:none}
footer{background:var(--panel);border-top:1px solid var(--line);color:var(--muted);font-size:.9rem;margin-top:3rem}
footer p{margin:0;padding:.9rem 1.5rem;max-width:64rem;margin-inline:auto}
@media(max-width:760px){.hero,.split{grid-template-columns:1fr}.reel{width:min(70%,16rem)}.credit{grid-template-columns:1fr;gap:.25rem}}
@media(prefers-reduced-motion:reduce){.reel,h1.title{animation:none}html{scroll-behavior:auto}}

.tags{margin:0 0 .5rem!important}.tag{display:inline-block;border:1px solid var(--orange);color:var(--orange);font-size:.75rem;line-height:1.5;padding:0 .5rem;margin:0 .4rem .4rem 0}.meta{font-size:.85rem!important}.frame .cap a{color:var(--orange)}.end{font:1.6rem var(--display);letter-spacing:.1em;text-align:center;color:var(--orange);margin:0;text-shadow:0 0 20px rgba(255,106,19,.35)}.gal{position:relative;background:#000}.slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.slides::-webkit-scrollbar{display:none}.frame .slides img{flex:0 0 100%;width:100%;aspect-ratio:4/5;object-fit:contain;scroll-snap-align:center;display:block}.gal .nav{position:absolute;top:50%;transform:translateY(-50%);width:2.25rem;height:2.25rem;background:rgba(13,11,9,.75);color:var(--orange);border:1px solid var(--orange);font:1.5rem/1 var(--body);cursor:pointer}.gal .prev{left:.5rem}.gal .next{right:.5rem}.dots{position:absolute;bottom:.6rem;left:0;right:0;display:flex;justify-content:center;gap:.45rem}.dots button{width:.65rem;height:.65rem;border-radius:50%;border:1px solid var(--orange);background:rgba(13,11,9,.6);padding:0;cursor:pointer}.dots button.on{background:var(--orange)}.gal.single .nav,.gal.single .dots{display:none}.page[hidden]{display:none}
body{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
</style>
</head>
